---
interface Props {
  file: string;
  mobileFile?: string;
  alt?: string;
  class?: string;
  style?: string;
}
const { file, mobileFile, alt = "", class: className, style } = Astro.props;
---

<span
  data-asset
  class:list={["figma-asset", className]}
  style={style}
  aria-hidden={alt ? undefined : "true"}
>
  <picture>
    {mobileFile && (
      <source
        media="(max-width: 900px)"
        srcset={`/assets/figma/${mobileFile}`}
      />
    )}
    <img src={`/assets/figma/${file}`} alt={alt} decoding="async" />
  </picture>
</span>
