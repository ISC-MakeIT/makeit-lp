---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { posts } from "../../data/content";
---

<BaseLayout title="Blog / News" class="blog-page">
  <div class="blog-banner">
    <h1>Blog</h1>
  </div>
  <div class="blog-container">
    <a class="featured-post" href={`/blog/${posts[0].slug}/`}>
      <h2>記事名</h2>
      <p>2025年〇〇月〇〇日</p>
    </a>
    <div class="blog-controls">
      <div class="sort-buttons" role="group" aria-label="記事の並び順">
        <button data-sort="newest" aria-pressed="true">
          新しい順
        </button>
        <button data-sort="oldest" aria-pressed="false">
          古い順
        </button>
      </div>
      <label class="period-filter">
        <span class="period-filter-icon" aria-hidden="true"></span>
        <span class="sr-only">記事の期間</span>
        <select id="period-filter">
          <option value="all">すべての期間</option>
          <option value="2000">2000年</option>
          <option value="2025">2025年</option>
        </select>
        <span class="period-chevron" aria-hidden="true"></span>
      </label>
    </div>
    <div class="blog-grid" id="blog-grid">
      {posts.map((post, index) => (
        <a
          href={`/blog/${post.slug}/`}
          class="blog-card"
          data-date={post.date}
          data-order={index}
        >
          <div class="blog-card-image">
            <span class="blog-card-arrow">
              <span class="css-arrow" aria-hidden="true"></span>
            </span>
          </div>
          <h2>
            {index === 0 ? "タイトルタイトルタイトルタイトル" : post.title}
          </h2>
          <time datetime={post.date}>{post.displayDate}</time>
        </a>
      ))}
    </div>
    <p id="blog-empty" class="empty-state" role="status" hidden>
      この期間の記事はありません。
    </p>
    <p class="blog-count sr-only" role="status" aria-live="polite">
      12件の記事
    </p>
  </div>
</BaseLayout>
<script>
  const grid = document.querySelector<HTMLElement>("#blog-grid")!;
  const cards = [...grid.querySelectorAll<HTMLElement>(".blog-card")];
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-sort]"),
  ];
  const period = document.querySelector<HTMLSelectElement>("#period-filter")!;
  let sort = "newest";
  function update() {
    const ordered = [...cards].sort((a, b) => {
      const difference =
        (a.dataset.date || "").localeCompare(b.dataset.date || "") ||
        Number(a.dataset.order) - Number(b.dataset.order);
      return sort === "newest" ? -difference : difference;
    });
    let count = 0;
    ordered.forEach((card) => {
      card.hidden =
        period.value !== "all" && !card.dataset.date?.startsWith(period.value);
      if (!card.hidden) count++;
      grid.append(card);
    });
    document.querySelector<HTMLElement>("#blog-empty")!.hidden = count > 0;
    document.querySelector<HTMLElement>(".blog-count")!.textContent =
      `${count}件の記事`;
    buttons.forEach((button) =>
      button.setAttribute("aria-pressed", String(button.dataset.sort === sort)),
    );
  }
  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      sort = button.dataset.sort || "newest";
      update();
    }),
  );
  period.addEventListener("change", update);
</script>
